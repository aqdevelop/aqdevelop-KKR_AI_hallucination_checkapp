# Set MOCK_MODE=true to run without any API keys (returns canned responses)
MOCK_MODE=true

ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

EXTRACTOR_MODEL=claude-haiku-4-5-20251001
VERIFIER_MODEL=claude-sonnet-4-6
CORRECTOR_MODEL=claude-sonnet-4-6

MAX_TEXT_LENGTH=5000
SEARCH_RESULTS_PER_QUERY=6
CACHE_TTL_DAYS=30

CORS_ORIGINS=*
