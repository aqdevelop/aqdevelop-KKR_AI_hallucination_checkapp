# Set MOCK_MODE=true to run without any API keys (returns canned responses)
MOCK_MODE=true

# --- LLM providers (route by model prefix in services/llm.py) ---
# claude-*  → uses ANTHROPIC_API_KEY
# gemini-*  → uses GEMINI_API_KEY
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Search providers (Korean priority: Naver → Brave → Google CSE) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Default to free Gemini Flash everywhere; switch to claude-sonnet-4-6 for
# higher-quality verification/correction once you have an Anthropic key.
EXTRACTOR_MODEL=gemini-2.5-flash
VERIFIER_MODEL=gemini-2.5-flash
CORRECTOR_MODEL=gemini-2.5-flash

MAX_TEXT_LENGTH=5000
SEARCH_RESULTS_PER_QUERY=6
CACHE_TTL_DAYS=30

CORS_ORIGINS=*
